# name: test/sql/attached_column_alias_scan.test
# description: Scan, filter and DELETE address physical field names when DuckDB deduplicates case-insensitive columns
# group: [sql]

require lance

statement ok
ATTACH '{TEST_DIR}/column_alias_scan' AS ns (TYPE LANCE);

# The physical fields are Foo, foo and foo_1. The attached catalog exposes
# them as Foo, foo_1 and foo_1_1.
statement ok
COPY (SELECT 1 AS "Foo", 2 AS "foo", 3 AS "foo_1" UNION ALL SELECT 10, 20, 30) TO '{TEST_DIR}/column_alias_scan/t.lance' (FORMAT lance);

query III
SELECT * FROM ns.t ORDER BY 1;
----
1	2	3
10	20	30

query I
SELECT foo_1 FROM ns.t ORDER BY 1;
----
2
20

query I
SELECT foo_1_1 FROM ns.t ORDER BY 1;
----
3
30

query II
SELECT "Foo", foo_1_1 FROM ns.t ORDER BY 1;
----
1	3
10	30

# Filters are pushed to Lance and must target the physical field.
query I
SELECT "Foo" FROM ns.t WHERE foo_1 = 20;
----
10

query I
SELECT "Foo" FROM ns.t WHERE foo_1_1 = 3;
----
1

query I
SELECT "Foo" FROM ns.t WHERE foo_1 IN (2, 20) AND foo_1_1 > 3;
----
10

query I
SELECT count(*) FROM ns.t WHERE foo_1 + foo_1_1 = 5;
----
1

query II
SELECT "Foo", foo_1_1 FROM ns.t WHERE foo_1 > 100 OR "Foo" = 1;
----
1	3

# Aggregates are pushed down by name and must not fold the case-colliding
# fields into one column.
query III
SELECT sum("Foo"), sum(foo_1), sum(foo_1_1) FROM ns.t;
----
11	22	33

query III
SELECT min(foo_1), max(foo_1_1), count(foo_1) FROM ns.t WHERE foo_1_1 > 3;
----
20	30	1

# Search functions read the same physical names.
statement ok
COPY (SELECT 1 AS "Foo", 2 AS "foo", 3 AS "foo_1", [1.0, 0.0]::FLOAT[2] AS v, 'alpha beta' AS txt UNION ALL SELECT 10, 20, 30, [0.0, 1.0]::FLOAT[2], 'gamma') TO '{TEST_DIR}/column_alias_scan/s.lance' (FORMAT lance);

query III
SELECT "Foo", foo_1, foo_1_1 FROM lance_vector_search('{TEST_DIR}/column_alias_scan/s.lance', 'v', [1.0, 0.0]::FLOAT[2], k = 2) ORDER BY "Foo";
----
1	2	3
10	20	30

query I
SELECT "Foo" FROM lance_vector_search('{TEST_DIR}/column_alias_scan/s.lance', 'v', [1.0, 0.0]::FLOAT[2], k = 2) WHERE foo_1 = 20;
----
10

query I
SELECT "Foo" FROM lance_vector_search('ns.main.s', 'v', [1.0, 0.0]::FLOAT[2], k = 2) WHERE foo_1_1 = 3;
----
1

# DELETE shares the scan path and must delete the matching row.
query II
DELETE FROM ns.t WHERE foo_1 = 20 RETURNING "Foo", foo_1_1;
----
10	30

query III
SELECT * FROM ns.t;
----
1	2	3

statement ok
DELETE FROM ns.t WHERE foo_1_1 = 3;

query I
SELECT count(*) FROM ns.t;
----
0
